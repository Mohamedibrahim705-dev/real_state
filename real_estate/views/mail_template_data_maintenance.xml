<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="email_template_maintenance" model="mail.template">
        <field name="name">Maintenance Request: {{ object.property_id.name }}</field>
        <field name="model_id" ref="real_estate.model_maintenance_request"/>
        <field name="subject">Upcoming Maintenance for {{ object.property_id.name }}</field>
        <field name="email_from">{{ (object.property_id.agent_id.email_formatted or user.email_formatted) }}</field>
        <field name="email_to">{{ object.assigned_to.email }}</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Dear <t t-out="object.assigned_to.name"/>,<br/><br/>
                    This is a friendly reminder that your maintenance request for <strong><t t-out="object.property_id.name"/></strong> 
                    is due on <strong><t t-out="object.scheduled_date"/></strong>.<br/><br/>
                    Actual Cost: <strong><t t-out="object.actual_cost"/></strong><br/><br/>
                    Please ensure the work is completed by the due date.<br/><br/>
                    Best regards,<br/>
                    <t t-out="object.property_id.agent_id.name or 'Real Estate Management'"/>
                </p>
            </div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>
</odoo>