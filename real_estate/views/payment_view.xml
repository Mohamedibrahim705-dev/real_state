<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lease Payment Tree View -->
    <record id="view_lease_payment_tree" model="ir.ui.view">
        <field name="name">lease.payment.tree</field>
        <field name="model">lease.payment</field>
        <field name="arch" type="xml">
            <tree string="Payments">
                <field name="name"/>
                <field name="lease_id"/>
                <field name="tenant_id"/>
                <field name="property_id"/>
                <field name="due_date"/>
                <field name="amount"/>
                <field name="late_fee"/>
                <field name="late_fee_applied"/>
                <field name="total_amount"/>
                <field name="payment_date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Lease Payment Form View -->
    <record id="view_lease_payment_form" model="ir.ui.view">
        <field name="name">lease.payment.form</field>
        <field name="model">lease.payment</field>
        <field name="arch" type="xml">
            <form string="Lease Payment">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,paid,reconciled"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Lease Information">
                            <field name="lease_id"/>
                            <field name="tenant_id"/>
                            <field name="property_id"/>
                        </group>
                        <group string="Payment Details">
                            <field name="due_date"/>
                            <field name="payment_date"/>
                            <field name="payment_method"/>
                        </group>
                        <group string="Financial Details">
                            <field name="amount"/>
                            <field name="late_fee"/>
                            <field name="late_fee_applied"/>
                            <field name="total_amount" readonly="1"/>
                        </group>
                    </group>
                    

                    <footer>
                        <field name="notes"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Lease Payment Action -->
    <record id="action_payment" model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="res_model">lease.payment</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first lease payment
            </p>
        </field>
    </record>
    <record id="ir_cron_auto_mark_paid" model="ir.cron">
        <field name="name">Real Estate: Auto Mark Payments Paid</field>
        <field name="model_id" ref="model_lease_payment"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_mark_paid()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>
</odoo>