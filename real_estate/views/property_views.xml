<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Property List View (Tree) -->
    <record id="view_property_tree" model="ir.ui.view">
        <field name="name">real_estate.property.tree</field>
        <field name="model">real_estate.property</field>
        <field name="arch" type="xml">
            <tree string="Properties">
                <field name="name"/>
                <field name="property_type"/>
                <field name="price"/>
                <field name="deposit" string="Deposit Amount"/> 
                <field name="bedrooms"/>
                <field name="create_date"/> 
                <field name="create_uid"/> 
                <field name="agent_id"/> 
            </tree>
        </field>
    </record>
        <!-- Property Form View -->
    <record id="view_property_form" model="ir.ui.view">
        <field name="name">real_estate.property.form</field>
        <field name="model">real_estate.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                            <header>
                    <button name="mark_as_occupied" string="Mark as Occupied" type="object" invisible="not available" class="oe_highlight"/>
                    <button name="mark_as_available" string="Mark as Available" type="object" invisible="available" class="oe_highlight"/>
                    <field name="available" invisible="1"/>       
                    <button name="update_description" string="Update Description" type="object" class="oe_highlight"/>  
                    <button name="deposit_add" string="Add Deposit" type="object" class="btn btn-outline-danger"/>      
                     <button name="add_bedroom" string="Add Bedroom" type="object" invisible="available" class="btn btn-outline-success"/>  
                    <button name="property_type_as_villa" string="Change to Villa" type="object" class="btn btn-secondary"/> 
                    <button name="set_agent_name" string="Set Agent Name" type="object" class="btn btn-outline-info"/>  
                    <button name="set_agent_email" string="Set Agent Email" type="object" class="btn btn-outline-info"/>  
                    <button name="price_appears_if_available" string="Show Price"  invisible="not available" type="object" class="btn btn-outline-primary"/> 
                     <field name="price" invisible="1"/>  
            
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Property Name"/>
                        </h1>
                    </div>
                    <group string="Property Details">
                        <group>
                            <field name="available"/>
                        </group>
                        <group>
                            <field name="price" />
                            <field name="deposit" string="Deposit Amount"/> 
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="property_type"/>
                            <field name="bedrooms"  /> 
                            <field name="create_date" /> 
                            <field name="create_uid"/> 
                            <field name="agent_id"/> 

                         
                           
                            
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
        <!-- property Search View -->
    <record id="view_property_search" model="ir.ui.view">
        <field name="name">real_estate.property.search</field>
        <field name="model">real_estate.property</field>
        <field name="arch" type="xml">
            <search string="Search Properties">
                <field name="name"/>
                <field name="price"/>
                <separator/>
                <filter string="Active" name="available" domain="[('available', '=', True)]"/>
                <filter string="Inactive" name="inavailable" domain="[('available', '=', False)]"/>
                <separator/>
                <filter string="Apartments" name="property_type" domain="[('property_type', '=', 'apartment')]" />
                <filter string="Houses" name="property_type" domain="[('property_type', '=', 'house')]" />
                <filter string="Villas" name="property_type" domain="[('property_type', '=', 'villa')]" />
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Type" name="group_by_type" context="{'group_by': 'property_type'}"/>
                    <filter string="Availability" name="group_by_availability" context="{'group_by': 'available'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Property Action (Links views together) -->
    <record id="action_property" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">real_estate.property</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first property
            </p>
        </field>
    </record>
        <record id="view_property_kanban" model="ir.ui.view">
        <field name="name">real_estate.property.kanban</field>
        <field name="model">real_estate.property</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="property_type"/>
                <field name="agent_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="mt-1">
                                    <field name="property_type" widget="selection"/>
                                </div>
                                 <div class="mt-1">
                                    <field name="agent_id" widget="selection"/>
                                </div>
                               
                               
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
</odoo>