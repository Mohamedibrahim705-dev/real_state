<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lease Tree View -->
    <record id="view_lease_tree" model="ir.ui.view">
        <field name="name">real_estate.lease.tree</field>
        <field name="model">real_estate.lease</field>
        <field name="arch" type="xml">
            <tree string="Leases">
                <field name="name"/>
                <field name="property_id"/>
                <field name="tenant_id"/>
                  <field name="state"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="monthly_rent"/>
                <field name="deposit_paid"/>
                <field name="user_id"/>
            </tree>
        </field>
    </record>

    <!-- Lease Form View -->
    <record id="view_lease_form" model="ir.ui.view">
        <field name="name">real_estate.lease.form</field>
        <field name="model">real_estate.lease</field>
        <field name="arch" type="xml">
            <form string="Lease">
            <header>
                <field name="state" widget="statusbar" statusbar_visible="draft,active,at_risk,expired,cancelled"/>
                <button name="mark_as_active" string="Activate" type="object" invisible="state != 'draft'" class="btn-primary"/>
                <button name="action_submit_request" string="Submit Maintenance Request" type="object" class="btn-primary"/>
                <button name="mark_set_back_to_draft" string="Set to Draft" type="object" invisible="state != 'active'" class="btn-secondary"/>
                <button name="send_reminder_email" string="Email Reminder" type="object" class="oe_highlight"/>
            </header>
                <sheet>
                <field name="lease_image" widget="image" class="oe_right oe_avatar" options="{'size': [120, 120]}"/>
                    <div name= "button_box" class="oe_button_box" >
                    <button name="action_open_related_maintenance" string="View Maintenance" icon="fa fa-list" 
                     type="object" />

                </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Lease Reference"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Lease Information">
                            <field name="property_id"/>
                            <field name="state"/>
                            <field name="user_id"/>
                            <field name="tenant_id"/>
                        </group>
                      
                         <group string="Financial Information">
                            <field name="monthly_rent"/>
                            <field name="deposit_paid"/>
                            <field name="total_cost" decoration-danger="1"/>
                            <field name="plumbing_cost"/>
                            <field name="electrical_cost"/>
                            <field name="air_condition_cost"/>
                            <field name="appliance_cost"/>
                            <field name="other_cost"/>
                            <field name ="is_active"/>
                        </group>

                        <group string="Dates">
                            <field name ="tenant_age"/>   
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="next_payment_date"/>
                            <field name='last_reminder_sent'/>

                            <field name="next_electric_recharge" string="Electricity Bill Date"/>
                            <field name ="duration_months"/>
                        </group>
                        <group>
                            <field name="cash_total"/>
                            <field name="check_total"/>
                            <field name="bank_transfer_total"/>
                            <field name="credit_card_total"/>
                            <field name="other_total"/>
                            <field name="payment_method_total"/>
                        </group>
                       


                    </group>

                    <notebook>
                        <page string="Notes">
                            <field name="notes" placeholder="Add lease notes..."/>
                        </page>
                        <page string="Payment Methods">
                        <group>
                            <field name="cash_total"/>
                            <field name="check_total"/>
                            <field name="bank_transfer_total"/>
                            <field name="credit_card_total"/>
                            <field name="other_total"/>
                            <field name="payment_method_total"/>
                        </group>
                       </page>
                            <page string="Maintenance Requests">
                            <field name="maintenance_ids">
                                <tree create="true" delete="false">
                                    <field name="name"/>
                                    <field name="issue_type"/>
                                    <field name="urgency"/>

                                </tree>
                            </field>
                       </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Lease Search View -->
    <record id="view_lease_search" model="ir.ui.view">
        <field name="name">real_estate.lease.search</field>
        <field name="model">real_estate.lease</field>
        <field name="arch" type="xml">
            <search string="Search Leases">
                <field name="name"/>
                <field name="property_id"/>
                <field name="tenant_id"/>
                <field name="start_date"/>
                <field name="end_date"/>

                <group expand="0" string="Group By">
                    <filter name="group_by_property" string="Property" context="{'group_by': 'property_id'}"/>
                    <filter name="group_by_tenant"  string="Tenant" context="{'group_by': 'tenant_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Lease Action -->
    <record id="action_lease" model="ir.actions.act_window">
        <field name="name">Leases</field>
        <field name="res_model">real_estate.lease</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_lease_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first lease
            </p>
        </field>
    </record>
        <record id="ir_cron_auto_expire_leases" model="ir.cron">
        <field name="name">Real Estate: Auto Expire Leases</field>
        <field name="model_id" ref="model_real_estate_lease"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_expire_leases()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_send_payment_reminders" model="ir.cron">
        <field name="name">Real Estate: Payment Reminder (Due Tomorrow)</field>
        <field name="model_id" ref="model_real_estate_lease"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_payment_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
